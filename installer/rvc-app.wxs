<!--
  RVC Realtime installer (WiX Toolset 5).
  Build (after assembling a fresh versioned payload with stage-onnx.ps1):
    cd installer
    wix build rvc-app.wxs -ext WixToolset.UI.wixext -culture ja-JP -bindpath Stage=../dist-work/RVC-Realtime-0.1.8-onnx -o ../dist/RVC-Realtime-0.1.8-alpha.msi
    All cabinets are embedded; distribute the single MSI after size verification.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="RVC Realtime" Manufacturer="RVC Realtime" Version="0.1.8" Scope="perMachine"
           UpgradeCode="abc1243c-ca79-481b-bf17-22c8a491a6d6" Language="1041" Codepage="932">
    <SummaryInformation Description="RVC Realtime - realtime voice changer" Codepage="932" />
    <!-- An install over an existing one replaces it (same version included, so a rebuild reinstalls). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="新しいバージョンの RVC Realtime がすでにインストールされています。" />
    <!-- The ONNX-only payload fits the Windows Installer 2GB package limit. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="icon/rvc-app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- The app needs an NVIDIA driver (it provides nvcuda.dll); CUDA itself is bundled. -->
    <Property Id="NVCUDA">
      <DirectorySearch Id="System64Search" Path="[System64Folder]" Depth="0">
        <FileSearch Name="nvcuda.dll" />
      </DirectorySearch>
    </Property>
    <Launch Condition="Installed OR NVCUDA"
            Message="NVIDIA のグラフィックスドライバーが見つかりません。RVC Realtime は NVIDIA の GPU と、CUDA 13 に対応したドライバーが必要です。https://www.nvidia.com/Download/index.aspx から最新のドライバーを入れてから、もう一度インストールしてください。" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="RVC Realtime" />
    </StandardDirectory>

    <!-- An update installs where the last install put it: the folder is remembered below, and read back
         here before the wizard shows it. Installs made before 0.1.4 left no such value, so those are
         asked once more. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="RememberedInstallFolder" Root="HKLM" Key="Software\RVC Realtime" Name="InstallFolder" Type="raw" />
    </Property>
    <Component Id="RememberInstallFolder" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKMU" Key="Software\RVC Realtime" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
    </Component>
    <!-- so "変更" in the app list, and any tool that reads it, point at the same folder -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuApp" Name="RVC Realtime" Target="[INSTALLFOLDER]rvc-app.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKMU" Key="Software\RVC Realtime" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopApp" Name="RVC Realtime" Target="[INSTALLFOLDER]rvc-app.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKMU" Key="Software\RVC Realtime" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="RVC Realtime">
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="RememberInstallFolder" />
      <Files Include="!(bindpath.Stage)\**" Directory="INSTALLFOLDER" />
    </Feature>

    <!-- Standard wizard: welcome, license, choose the install folder, confirm, install, and an option to start the app. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="RVC Realtime を起動する" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="[INSTALLFOLDER]rvc-app.exe" Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <ui:WixUI Id="WixUI_InstallDir" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>
</Wix>
